+	if len(controlAssetGroup.Inputs) == 0 {
+		return errors.CONTROL_ASSET_INVALID.New(
+			"control asset %s is not spent by the reissuance", ctrlAssetID,
+		).WithMetadata(errors.ControlAssetMetadata{AssetID: ctrlAssetID})
diff --git a/pkg/ark-lib/asset/tx_validation_policy_test.go b/pkg/ark-lib/asset/tx_validation_policy_test.go
new file mode 100644
index 00000000..7f1af547
--- /dev/null
+++ b/pkg/ark-lib/asset/tx_validation_policy_test.go
@@ -0,0 +1,184 @@
+package asset_test
+
+import (
+	"bytes"
+	"context"
+	"fmt"
+	"strings"
+	"testing"
+
+	"github.com/arkade-os/arkd/pkg/ark-lib/asset"
+	"github.com/arkade-os/arkd/pkg/ark-lib/extension"
+	"github.com/btcsuite/btcd/chaincfg/chainhash"
+	"github.com/btcsuite/btcd/txscript"
+	"github.com/btcsuite/btcd/wire"
+	"github.com/stretchr/testify/require"
+)
+
+func TestSameScriptTransferPolicy(t *testing.T) {
+	xpID, err := asset.NewAssetId(strings.Repeat("11", 32), 3)
+	require.NoError(t, err)
+	controlID, err := asset.NewAssetId(strings.Repeat("11", 32), 1)
+	require.NoError(t, err)
+
+	inputScript := p2trScript(0x11)
+	otherScript := p2trScript(0x22)
+	tests := []struct {
+		name           string
+		metadata       bool
+		outputScripts  [][]byte
+		outputAmounts  []uint64
+		includeControl bool
+		wantError      bool
+	}{
+		{
+			name:          "unmarked asset remains freely transferable",
+			outputScripts: [][]byte{otherScript, otherScript},
+			outputAmounts: []uint64{4, 6},
+		},
+		{
+			name:          "one-to-one same-script renewal",
+			metadata:      true,
+			outputScripts: [][]byte{inputScript},
+			outputAmounts: []uint64{10},
+		},
+		{
+			name:          "different script rejected",
+			metadata:      true,
+			outputScripts: [][]byte{otherScript},
+			outputAmounts: []uint64{10},
+			wantError:     true,
+		},
+		{
+			name:          "split rejected",
+			metadata:      true,
+			outputScripts: [][]byte{inputScript, inputScript},
+			outputAmounts: []uint64{4, 6},
+			wantError:     true,
+		},
+		{
+			name:           "spent control asset authorizes transfer",
+			metadata:       true,
+			outputScripts:  [][]byte{otherScript},
+			outputAmounts:  []uint64{10},
+			includeControl: true,
+		},
+		{
+			name:           "spent control asset authorizes reissuance",
+			metadata:       true,
+			outputScripts:  [][]byte{otherScript},
+			outputAmounts:  []uint64{11},
+			includeControl: true,
+		},
+		{
+			name:           "spent control asset authorizes burn",
+			metadata:       true,
+			includeControl: true,
+		},
+	}
+
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			tx := wire.NewMsgTx(3)
+			tx.AddTxIn(wire.NewTxIn(&wire.OutPoint{}, nil, nil))
+			for _, script := range test.outputScripts {
+				tx.AddTxOut(wire.NewTxOut(330, script))
+			}
+			if len(test.outputScripts) == 0 {
+				tx.AddTxOut(wire.NewTxOut(330, otherScript))
+			}
+
+			xpOutputs := make([]asset.AssetOutput, 0, len(test.outputAmounts))
+			for index, amount := range test.outputAmounts {
+				xpOutputs = append(xpOutputs, asset.AssetOutput{
+					Type:   asset.AssetOutputTypeLocal,
+					Vout:   uint16(index),
+					Amount: amount,
+				})
+			}
+			packet := asset.Packet{{
+				AssetId: xpID,
+				Inputs: []asset.AssetInput{{
+					Type:   asset.AssetInputTypeLocal,
+					Vin:    0,
+					Amount: 10,
+				}},
+				Outputs: xpOutputs,
+			}}
+			prevouts := map[int][]asset.Asset{
+				0: {{AssetId: xpID.String(), Amount: 10}},
+			}
+			prevoutScripts := map[int][]byte{0: inputScript}
+			if test.includeControl {
+				tx.AddTxIn(wire.NewTxIn(&wire.OutPoint{Index: 1}, nil, nil))
+				packet = append(packet, asset.AssetGroup{
+					AssetId: controlID,
+					Inputs: []asset.AssetInput{{
+						Type:   asset.AssetInputTypeLocal,
+						Vin:    1,
+						Amount: 1,
+					}},
+					Outputs: []asset.AssetOutput{{
+						Type:   asset.AssetOutputTypeLocal,
+						Vout:   0,
+						Amount: 1,
+					}},
+				})
+				prevouts[1] = []asset.Asset{{AssetId: controlID.String(), Amount: 1}}
+				prevoutScripts[1] = otherScript
+			}
+
+			ext, err := extension.NewExtensionFromPackets(packet)
+			require.NoError(t, err)
+			extensionOutput, err := ext.TxOut()
+			require.NoError(t, err)
+			tx.AddTxOut(extensionOutput)
+
+			source := &policyAssetSource{
+				xpID:       xpID.String(),
+				controlID:  controlID.String(),
+				restricted: test.metadata,
+			}
+			err = asset.ValidateAssetTransaction(
+				t.Context(), tx, packet, prevouts, prevoutScripts, source,
+			)
+			if test.wantError {
+				require.ErrorContains(t, err, "requires a spent control asset")
+			} else {
+				require.NoError(t, err)
+			}
+		})
+	}
+}
+
+type policyAssetSource struct {
+	xpID       string
+	controlID  string
+	restricted bool
+}
+
+func (s *policyAssetSource) AssetExists(_ context.Context, _ string) bool {
+	return true
+}
+
+func (s *policyAssetSource) GetControlAsset(_ context.Context, assetID string) (string, error) {
+	if assetID == s.xpID {
+		return s.controlID, nil
+	}
+	return "", fmt.Errorf("control asset not found for asset %s", assetID)
+}
+
+func (s *policyAssetSource) GetAssetMetadata(_ context.Context, assetID string) ([]asset.Metadata, error) {
+	if assetID != s.xpID || !s.restricted {
+		return nil, nil
+	}
+	policy, err := asset.NewMetadata("transfer_policy", "same_script")
+	if err != nil {
+		return nil, err
+	}
+	return []asset.Metadata{*policy}, nil
+}
+
+func p2trScript(fill byte) []byte {
+	return append([]byte{txscript.OP_1, 32}, bytes.Repeat([]byte{fill}, chainhash.HashSize)...)
+}
