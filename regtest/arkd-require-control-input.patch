+
+// validateTransferPolicy restricts assets marked transfer_policy=same_script.
+// A spent control asset authorizes arbitrary issuance or burn shapes. Without
+// that authority, the asset must move one-to-one back to the exact input
+// script, which permits renewal but prevents transfer, split, or aggregation.
+func validateTransferPolicy(
+	ctx context.Context,
+	tx *wire.MsgTx,
+	packet Packet,
+	group AssetGroup,
+	assetPrevoutScripts map[int][]byte,
+	assetSrc AssetSource,
+) errors.Error {
+	assetID := group.AssetId.String()
+	if assetSrc == nil {
+		return errors.ASSET_VALIDATION_FAILED.New(
+			"asset source is nil, cannot validate transfer policy for %s", assetID,
+		).WithMetadata(errors.AssetValidationMetadata{AssetID: assetID})
+	}
+	metadata, err := assetSrc.GetAssetMetadata(ctx, assetID)
+	if err != nil {
+		return errors.ASSET_VALIDATION_FAILED.Wrap(err).
+			WithMetadata(errors.AssetValidationMetadata{AssetID: assetID})
+	}
+	if !hasSameScriptTransferPolicy(metadata) {
+		return nil
+	}
+
+	ctrlAssetID, err := assetSrc.GetControlAsset(ctx, assetID)
+	if err != nil {
+		return errors.ASSET_VALIDATION_FAILED.Wrap(err).
+			WithMetadata(errors.AssetValidationMetadata{AssetID: assetID})
+	}
+	if controlGroup := findAssetGroupByAssetId(packet, ctrlAssetID); controlGroup != nil &&
+		len(controlGroup.Inputs) > 0 {
+		return nil
+	}
+
+	policyError := func() errors.Error {
+		return errors.ASSET_VALIDATION_FAILED.New(
+			"asset %s requires a spent control asset or one equal-amount output to the input script",
+			assetID,
+		).WithMetadata(errors.AssetValidationMetadata{AssetID: assetID})
+	}
+	if len(group.Inputs) != 1 || len(group.Outputs) != 1 ||
+		group.Inputs[0].Amount != group.Outputs[0].Amount {
+		return policyError()
+	}
+
+	inputScript, ok := assetPrevoutScripts[int(group.Inputs[0].Vin)]
+	if !ok {
+		return errors.ASSET_VALIDATION_FAILED.New(
+			"input script not found for restricted asset %s", assetID,
+		).WithMetadata(errors.AssetValidationMetadata{AssetID: assetID})
+	}
+	outputScript := tx.TxOut[int(group.Outputs[0].Vout)].PkScript
+	if !bytes.Equal(inputScript, outputScript) {
+		return policyError()
@@ -108,0 +189,10 @@ func ValidateAssetTransaction(
+func hasSameScriptTransferPolicy(metadata []Metadata) bool {
+	for _, entry := range metadata {
+		if string(entry.Key) == transferPolicyMetadataKey &&
+			string(entry.Value) == sameScriptTransferPolicy {
+			return true
+		}
+	}
+	return false
+}
+
@@ -135,0 +226,5 @@ func validateReissuance(
