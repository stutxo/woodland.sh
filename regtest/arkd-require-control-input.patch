+	assetSrc AssetSource,
@@ -103,0 +115,69 @@ func ValidateAssetTransaction(
+		if !group.IsIssuance() {
+			if err := validateTransferPolicy(
+				ctx, tx, packet, group, assetPrevoutScripts, assetSrc,
+			); err != nil {
+				return err
+			}
+		}
+	}
+
+	return nil
