# Install as /etc/woodland/emulator-gate.env with root:woodland-gate 0640 permissions.
# Keep the stock emulator and Bitcoin RPC bound to loopback; expose only the
# gate through an HTTPS reverse proxy.
WOODLAND_EMULATOR_GATE_BIND=127.0.0.1:7074
WOODLAND_EMULATOR_UPSTREAM_URL=http://127.0.0.1:7073
WOODLAND_BITCOIN_RPC_URL=http://127.0.0.1:8332
WOODLAND_BITCOIN_RPC_USER=replace-with-dedicated-rpc-user
WOODLAND_BITCOIN_RPC_PASSWORD=replace-with-rpcauth-password
WOODLAND_EMULATOR_GATE_ORIGIN=https://replace-with-public-app-origin.example
