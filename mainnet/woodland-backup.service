[Unit]
Description=Woodland private host backup (latest 30 archives)
After=woodland-server.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/opt/woodland/woodland-backup.sh
UMask=0077
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=/var/backups/woodland
RestrictAddressFamilies=AF_UNIX
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
AmbientCapabilities=
Nice=10
IOSchedulingClass=idle
