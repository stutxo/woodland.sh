# Install as /etc/woodland/leaderboard.env with root:woodland-leaderboard 0640 permissions.
# This process is public and read-only: never add deployer, maintenance, or rollover secrets.
WOODLAND_WORLD_MANIFEST=/etc/woodland/woodland-world.json
WOODLAND_LEADERBOARD_PUBLIC_URL=https://replace-with-leaderboard-api.example
WOODLAND_LEADERBOARD_ORIGIN=https://replace-with-pages-origin.example
WOODLAND_LEADERBOARD_BIND=127.0.0.1:8090
WOODLAND_LEADERBOARD_DB=/var/lib/woodland-leaderboard/players.json
WOODLAND_LEADERBOARD_REFRESH_SECONDS=30
