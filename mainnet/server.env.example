# Install as /etc/woodland/server.env with root:woodland-server 0640 permissions.
WOODLAND_WORLD_MANIFEST=/etc/woodland/woodland-world.json
WOODLAND_SERVER_PUBLIC_URL=https://replace-with-server-api.example
WOODLAND_SERVER_ORIGIN=https://replace-with-pages-origin.example
WOODLAND_SERVER_BIND=127.0.0.1:8090
WOODLAND_SERVER_DB=/var/lib/woodland-server/players.json
WOODLAND_SERVER_REFRESH_SECONDS=15
# Optional; remove this line to disable delegated renewal.
WOODLAND_ROLLOVER_SECRET=replace-from-generated-maintenance.env
