# Renewal watcher unit. Separate from woodland-server because the watcher is
# mandatory while the social server is optional: an expired tree or vault is
# swept by the Arkade service and cannot be recovered. Tree and vault renewal
# leaves are permissionless {operator}; the rollover child only triggers exact
# covenant self-sends. Restocks are permissionless {operator, emulator}
# service-signed transactions and need no project key.
[Unit]
Description=woodland.sh mainnet renewal watcher
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=woodland
Group=woodland
WorkingDirectory=/opt/woodland
EnvironmentFile=/etc/woodland/mainnet.env
ExecStart=/opt/woodland/woodland-operator watch /etc/woodland/woodland-world.json
Restart=always
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
